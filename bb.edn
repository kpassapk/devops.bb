{:paths ["src"]
 :deps {io.github.kpassapk/charm.clj
        {:git/url "https://github.com/kpassapk/charm.clj.git"
         :git/sha "b1b40757fc12e82da87c13c362c8c5308c33df3f"}}

 :tasks
 {dashboard
  {:doc "Follow the devops.el execution log in a TUI"
   :exec-fn devops.bb.dashboard/run
   :org.babashka/cli {:spec {:log  {:desc "Execution log; default: devops-bb-execution-log from Emacs"}
                             :feed {:desc "A sandbox's feed dir; default: DEVOPS_BB_FEED. Emacs is never asked"}}}}

  status     {:doc "Is Emacs reachable, devops-mode on, and where does it log"
              :exec-fn devops.bb.cli/status}
  output     {:doc "FILE LINE [--tag T]: what a block printed"
              :exec-fn devops.bb.cli/output}
  run-output {:doc "ID [--session S]: what one run printed"
              :exec-fn devops.bb.cli/run-output}
  sessions   {:doc "Live async sessions"
              :exec-fn devops.bb.cli/sessions}
  follow     {:doc "[--dir D] [--json] [--after SEQ]: a line per new log event under D, or feed event"
              :exec-fn devops.bb.cli/follow}
  modified   {:doc "FILE: does Emacs hold unsaved edits to it (feed mode: FILE optional)"
              :exec-fn devops.bb.cli/modified}
  revert     {:doc "FILE: reload its buffer from disk"
              :exec-fn devops.bb.cli/revert}
  tools      {:doc "[REGEXP]: tools.org blocks for #+call:"
              :exec-fn devops.bb.cli/tools}
  drift      {:doc "FILE [--heading H | --custom-id ID]: compare tangles with targets"
              :exec-fn devops.bb.cli/drift}
  publish    {:doc "--to DIR [--via CMD] [--map HOST=SANDBOX] [--max-lines N] [--max-bytes N] [--name N]: stdin to a sandbox's feed"
              :exec-fn devops.bb.cli/publish}

  repo-clone   {:doc "[--heading H]: clone the seed bundle in the workbook's dir, on the heading's branch"
                :exec-fn devops.bb.repo/repo-clone}
  repo-handoff {:doc "[--heading H]: bundle every branch with new commits into the workbook's dir"
                :exec-fn devops.bb.repo/repo-handoff}
  repo-rebase  {:doc "[--heading H] [--continue]: rebase the branch onto its base's new tip, from NAME.base.bundle"
                :exec-fn devops.bb.repo/repo-rebase}
  wt-add       {:doc "--workbook F --heading H: the heading's worktree, with the live workbook in it"
                :exec-fn devops.bb.repo/wt-add}
  wt-seed      {:doc "--workbook F --heading H [--rebase]: bundle the branches for the agent"
                :exec-fn devops.bb.repo/wt-seed}
  wt-land      {:doc "--workbook F --heading H [--apply]: fetch the agent's bundle into refs/sandbox/*"
                :exec-fn devops.bb.repo/wt-land}
  wt-status    {:doc "--workbook F: each heading's branch, worktree, seed and unlanded commits"
                :exec-fn devops.bb.repo/wt-status}

  test-emacs
  {:doc "Run the Emacs side's ERT tests; DEVOPS_EL, CLJBANG and OB_CONFIRM_POSFRAME are its checkouts, default ../devops.el, ../cljbang.el and ../ob-confirm-posframe"
   :requires ([babashka.fs :as fs])
   :task (let [root (fs/parent (fs/absolutize *file*))
               dir (fn [env sibling]
                     (str (or (System/getenv env) (fs/normalize (fs/path root ".." sibling)))))]
           ;; Watchdog: batch ERT can hang on a prompt.  macOS has no `timeout'.
           (shell "perl" "-e" "alarm shift; exec @ARGV" "300"
                  "emacs" "--batch"
                  "-L" (dir "DEVOPS_EL" "devops.el")
                  "-L" (dir "CLJBANG" "cljbang.el")
                  "-L" (dir "OB_CONFIRM_POSFRAME" "ob-confirm-posframe")
                  "-L" (str (fs/path root "emacs"))
                  "-L" (str (fs/path root "emacs" "test"))
                  "--eval" "(setq native-comp-enable-subr-trampolines nil)"
                  "--eval" "(require 'devops-bb-test)"
                  "--eval" "(ert-run-tests-batch-and-exit \"^devops-bb-\")"))}

  test
  {:doc "Run tests"
   :extra-paths ["test"]
   :requires ([clojure.test :as t]
              [devops.bb.cli-test]
              [devops.bb.feed-test]
              [devops.bb.log-test]
              [devops.bb.model-test]
              [devops.bb.org-test]
              [devops.bb.repo-test]
              [devops.bb.view-test])
   :task (let [{:keys [fail error]} (t/run-tests 'devops.bb.cli-test
                                                 'devops.bb.feed-test
                                                 'devops.bb.log-test
                                                 'devops.bb.model-test
                                                 'devops.bb.org-test
                                                 'devops.bb.repo-test
                                                 'devops.bb.view-test)]
           (when (pos? (+ fail error)) (System/exit 1)))}}}
